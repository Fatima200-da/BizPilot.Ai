// =============================================================================
// SECTION 8 — Workflow Engine
// Resolves AI_PLATFORM_ARCHITECTURE.md Section 10.1's explicit deferral:
// "a WorkflowInstance's durable state... requires persistence beyond what any
// existing DATABASE.md model provides — (future schema extension, not
// required today)." Formalized in PRODUCT_EXECUTION_AND_MVP_ARCHITECTURE.md
// Section 38.2. Behavior (state machine, step dispatch, retry, scheduling)
// is fully specified there and in BACKEND_ARCHITECTURE.md Section 8 — this
// section supplies only the persistence shape, not a new engine.
// =============================================================================

model WorkflowDefinition {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String?                  @db.Uuid // null = system-defined, available to every workspace
  key             String // e.g. "marketing-autopilot"
  name            String
  description     String?
  version         Int                      @default(1)
  isSystemDefined Boolean                  @default(false)
  status          WorkflowDefinitionStatus @default(ACTIVE)
  stepGraph       Json // ordered step definitions: [{ key, order, kind, config }]
  deletedAt       DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  workspace Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instances WorkflowInstance[]

  // NOTE: same partial-unique-index caveat as Role (workspaceId IS NULL rows
  // are never considered duplicates by Postgres in a composite unique
  // constraint) — system-defined key/version uniqueness is enforced by the
  // seed script, matching the existing documented pattern for Role.
  @@unique([workspaceId, key, version])
  @@index([key])
  @@map("workflow_definitions")
}

model WorkflowInstance {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String                 @db.Uuid
  workflowDefinitionId String                 @db.Uuid
  businessProfileId    String?                @db.Uuid
  triggeredByUserId    String?                @db.Uuid // null = system/scheduled trigger
  status               WorkflowInstanceStatus @default(PENDING)
  outcomeSignal        WorkflowOutcomeSignal  @default(PENDING)
  idempotencyKey       String? // caller-supplied; prevents duplicate-run creation on retried requests
  currentStepKey       String?
  input                Json // workflow start input (goals, platform selection, etc.)
  output               Json? // final assembled output once COMPLETED
  error                Json? // last failure detail, if any
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflowDefinition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id])
  businessProfile    BusinessProfile?   @relation(fields: [businessProfileId], references: [id], onDelete: SetNull)
  triggeredBy        User?              @relation(fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  stepRuns           WorkflowStepRun[]
  contentAssets      ContentAsset[]

  // Idempotency is scoped per workspace+definition, not globally, matching
  // BACKEND_ARCHITECTURE.md Section 8.5's existing idempotency-key discipline.
  @@unique([workspaceId, workflowDefinitionId, idempotencyKey])
  @@index([workspaceId, status])
  @@index([workflowDefinitionId])
  // Phase 30 Track I.17: same real gap as ai_usages above — the admin
  // dashboard's cross-tenant 30-day workflow-run aggregate filters on
  // createdAt alone; the existing (workspaceId, status) index doesn't cover it.
  @@index([createdAt])
  @@map("workflow_instances")
}

model WorkflowStepRun {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowInstanceId String             @db.Uuid
  stepKey            String
  stepOrder          Int
  status             WorkflowStepStatus @default(PENDING)
  attempt            Int                @default(1)
  input              Json?
  output             Json?
  error              Json?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  workflowInstance WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)

  // Reuses BACKEND_ARCHITECTURE.md Section 8.5's idempotent-handler pattern:
  // a retried attempt of the same step is a new row (audit trail preserved),
  // never an in-place overwrite of a prior attempt's result.
  @@unique([workflowInstanceId, stepKey, attempt])
  @@index([workflowInstanceId, status])
  @@map("workflow_step_runs")
}

enum WorkflowDefinitionStatus {
  DRAFT
  ACTIVE
  DEPRECATED
}

enum WorkflowInstanceStatus {
  PENDING
  RUNNING
  AWAITING_APPROVAL
  COMPLETED
  FAILED
  RETRYING
  CANCELLED
}

enum WorkflowStepStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  RETRYING
  SKIPPED
}

enum WorkflowOutcomeSignal {
  PENDING
  ACCEPTED
  EDITED
  DISMISSED
}

/// Phase 28 Section "Recurring workflows": a persisted, server-validated
/// recurring schedule for a real WorkflowDefinition. Timezone is stored
/// explicitly (IANA name, e.g. "America/New_York") and interpreted via
/// `luxon` (which uses Node's built-in ICU/timezone data) — `nextRunAt` is
/// always computed and stored as a real UTC instant, never left to the
/// scheduler process's local machine timezone. Duplicate-execution
/// prevention across concurrent scheduler instances is NOT this table's
/// job — it is the real Postgres unique constraint on the `Job` table
/// (jobKey, dedupeKey) this scheduler enqueues into (job-queue.service.ts,
/// Phase 27), keyed by `${scheduledWorkflowId}:${occurrence ISO}` so two
/// scheduler processes racing to fire the same occurrence collide safely.
model ScheduledWorkflow {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId           String               @db.Uuid
  workflowDefinitionKey String
  businessProfileId     String?              @db.Uuid
  createdByUserId       String?              @db.Uuid
  name                  String
  intervalUnit          ScheduleIntervalUnit
  intervalValue         Int                  @default(1)
  timeOfDay             String? // "HH:mm", required for DAY/WEEK/MONTH granularity
  dayOfWeek             Int? // 0 (Sunday) - 6 (Saturday), required for WEEK granularity
  timezone              String               @default("UTC") // IANA name
  input                 Json?
  enabled               Boolean              @default(true)
  nextRunAt             DateTime // always a real, computed UTC instant
  lastRunAt             DateTime?
  lastRunStatus         String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([enabled, nextRunAt])
  @@index([workspaceId])
  @@map("scheduled_workflows")
}

enum ScheduleIntervalUnit {
  MINUTE
  HOUR
  DAY
  WEEK
  MONTH
}

// =============================================================================
// SECTION 9 — CRM Foundation
// Formalized in PRODUCT_EXECUTION_AND_MVP_ARCHITECTURE.md Section 38.3.
// Deliberately minimal — see that document's rejected-alternatives note
// (no Deal/Opportunity/Pipeline entity at this horizon).
// =============================================================================

model Contact {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String        @db.Uuid
  businessProfileId String?       @db.Uuid
  fullName          String
  phone             String?
  email             String?
  source            ContactSource @default(MANUAL)
  notes             String?
  deletedAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  businessProfile BusinessProfile? @relation(fields: [businessProfileId], references: [id], onDelete: SetNull)
  leads           Lead[]

  @@index([workspaceId])
  @@index([phone])
  @@index([email])
  @@map("contacts")
}

model Lead {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String        @db.Uuid
  contactId   String        @db.Uuid
  status      LeadStatus    @default(NEW)
  source      ContactSource @default(MANUAL)
  intent      Json? // structured classification output, extension point per PRODUCT_EXECUTION_AND_MVP_ARCHITECTURE.md Section 17
  followUpAt  DateTime?
  ownerUserId String?       @db.Uuid
  notes       String?
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  owner     User?     @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([contactId])
  @@index([ownerUserId])
  @@map("leads")
}

enum BusinessLanguage {
  AZ
  EN
  RU
}

enum ContactSource {
  WHATSAPP
  INSTAGRAM
  MANUAL
  IMPORT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

// =============================================================================
// SECTION 10 — Content Assets (Marketing Autopilot, Phase 15)
// One row per calendar item generated by the Marketing Autopilot workflow
// (Phase 15 Section 7, step 06 "Persist Content Assets") — an individually
// addressable, editable, approvable unit, distinct from WorkflowInstance's
// assembled `output` snapshot (Part 38.2). Justified as new because Phase 15
// explicitly requires per-item edit/approve/status lifecycle and provenance
// (generated vs. human-edited) — not needed by the workflow engine itself.
// =============================================================================

model ContentAsset {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String             @db.Uuid
  workflowInstanceId String             @db.Uuid
  businessProfileId  String?            @db.Uuid
  day                Int // 1-30
  scheduledDate      DateTime?
  platform           String // e.g. "instagram", "whatsapp_status"
  contentType        String // e.g. "carousel", "reel", "story", "single_post"
  pillarKey          String?
  topic              String
  hook               String?
  keyMessage         String?
  caption            String // AI-generated caption/copy
  editedCaption      String? // human-edited version; null until first edit (provenance, Section 25)
  cta                String?
  visualDirection    String?
  status             ContentAssetStatus @default(DRAFT)
  approvedByUserId   String?            @db.Uuid
  approvedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflowInstance WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  businessProfile  BusinessProfile? @relation(fields: [businessProfileId], references: [id], onDelete: SetNull)
  approvedBy       User?            @relation(fields: [approvedByUserId], references: [id], onDelete: SetNull)

  // Phase 20 Section 8.1: the real domain identity of a generated content
  // piece is "the content for this workflow run, scheduled for day N, on
  // platform P, of content type T" — NOT (workflowInstanceId, day) alone.
  // calendarOutputSchema (marketing-autopilot.schemas.ts) deliberately
  // allows 28-31 items with no day-uniqueness constraint, because a real
  // content calendar can legitimately schedule more than one piece on the
  // same day across different platforms (e.g. an Instagram carousel AND a
  // WhatsApp status both on day 5) — collapsing that to (day) alone would
  // silently drop a legitimate second item as a "duplicate". This
  // constraint is what persist_assets' upsert (marketing-autopilot.steps.ts)
  // keys on, making a retried persist_assets step safely re-runnable rather
  // than creating a second set of rows.
  @@unique([workflowInstanceId, day, platform, contentType])
  @@index([workspaceId, status])
  @@index([workflowInstanceId])
  @@map("content_assets")
}

enum ContentAssetStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
}
