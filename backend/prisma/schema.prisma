}

model Template {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String?            @db.Uuid // null = system template
  categoryId     String?            @db.Uuid
  authorUserId   String?            @db.Uuid
  type           TemplateType
