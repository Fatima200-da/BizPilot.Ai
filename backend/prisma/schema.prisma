// =============================================================================
// SECTION 5 — Content & Files (Projects, Folders, Files, Images)
// =============================================================================

model Project {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId           String        @db.Uuid
  businessProfileId     String?       @db.Uuid
  name                  String
  description           String?
  status                ProjectStatus
  createdFromTemplateId String?       @db.Uuid
  ownerUserId           String        @db.Uuid
  deletedAt             DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  workspace           Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  businessProfile     BusinessProfile? @relation(fields: [businessProfileId], references: [id], onDelete: SetNull)
  createdFromTemplate Template?        @relation(fields: [createdFromTemplateId], references: [id], onDelete: SetNull)
  owner               User             @relation(fields: [ownerUserId], references: [id])
  members             ProjectMember[]
  folders             Folder[]
  files               File[]
  conversations       Conversation[]

  @@index([workspaceId])
  @@index([status])
  @@index([ownerUserId])
  @@map("projects")
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

/// Project membership must be a subset of workspace membership — referencing
/// WorkspaceMember (not User directly) enforces that structurally.
model ProjectMember {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId         String   @db.Uuid
  workspaceMemberId String   @db.Uuid
  createdAt         DateTime @default(now())

  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspaceMember WorkspaceMember @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)

  @@unique([projectId, workspaceMemberId])
  @@map("project_members")
}

model Folder {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String    @db.Uuid
  projectId      String?   @db.Uuid
  parentFolderId String?   @db.Uuid
  name           String
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent    Folder?   @relation("FolderHierarchy", fields: [parentFolderId], references: [id], onDelete: SetNull)
  children  Folder[]  @relation("FolderHierarchy")
  files     File[]

  // App-layer enforces parentFolderId (when set) belongs to the same workspaceId.
  @@index([workspaceId])
  @@index([projectId])
  @@index([parentFolderId])
  @@map("folders")
}

model File {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String     @db.Uuid
  folderId         String?    @db.Uuid
  projectId        String?    @db.Uuid
  uploadedByUserId String?    @db.Uuid
  kind             FileKind
  status           FileStatus
  fileName         String
  mimeType         String
  sizeBytes        BigInt
  storageKey       String // object-storage key; binary content never lives in Postgres
  storageUrl       String? // cached signed/public URL, may be regenerated
  checksum         String? // sha256, for de-duplication/integrity
  deletedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  workspace            Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder               Folder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  project              Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  uploadedBy           User?             @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  image                Image?
  businessProfileLogos BusinessProfile[]

  @@index([workspaceId])
  @@index([folderId])
  @@index([projectId])
  @@index([checksum])
  @@map("files")
}

enum FileKind {
  DOCUMENT
  IMAGE
  VIDEO
  AUDIO
  ARCHIVE
  OTHER
}

enum FileStatus {
  UPLOADING
  READY
  PROCESSING
  FAILED
}

/// Specializes File with image-specific metadata. 1:1 composition, not
/// inheritance — keeps File generic for every asset kind.
model Image {
  id                         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fileId                     String   @unique @db.Uuid
  width                      Int?
  height                     Int?
  altText                    String?
  dominantColor              String?
  generatedByPromptVersionId String?  @db.Uuid
  generatedByAiUsageId       String?  @unique @db.Uuid
  businessProfileId          String?  @db.Uuid
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  file                     File             @relation(fields: [fileId], references: [id], onDelete: Cascade)
  generatedByPromptVersion PromptVersion?   @relation(fields: [generatedByPromptVersionId], references: [id], onDelete: SetNull)
  generatedByAiUsage       AIUsage?         @relation(fields: [generatedByAiUsageId], references: [id], onDelete: SetNull)
  businessProfile          BusinessProfile? @relation(fields: [businessProfileId], references: [id], onDelete: SetNull)

  @@map("images")
}

// =============================================================================
// SECTION 6 — Collaboration & Governance (Notifications, Audit, Activity)
// =============================================================================

model NotificationPreference {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String               @db.Uuid
  workspaceId String               @db.Uuid
  category    NotificationCategory
  channel     NotificationChannel
  enabled     Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId, category, channel])
  @@map("notification_preferences")
}

model Notification {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String?              @db.Uuid
  recipientUserId   String               @db.Uuid
  category          NotificationCategory
  // Phase 26 Section 5: the specific, addressable event type — `category`
  // remains the coarse admin-UI grouping (unchanged); `type` is what the
  // idempotency guarantee and the frontend's icon/copy selection key off.
  type              NotificationType
  channel           NotificationChannel
  title             String
  body              String?
  linkUrl           String?
  relatedEntityType String?
  relatedEntityId   String?
  readAt            DateTime?
  sentAt            DateTime?
  createdAt         DateTime             @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipient User       @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  // Idempotent creation: at most one notification per (workspace, type,
  // related entity) — e.g. one CREDITS_LOW alert per workspace per billing
  // period, one INVITATION_RECEIVED per invite. A real Postgres unique
  // constraint, not an app-level check-then-insert race.
  @@unique([workspaceId, type, relatedEntityId])
  @@index([recipientUserId, readAt])
  @@index([workspaceId, category])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationType {
  WELCOME
  ONBOARDING_REMINDER
  INVITATION_RECEIVED
  INVITATION_ACCEPTED
  SUBSCRIPTION_CHANGED
  SUBSCRIPTION_CANCELED
  SUBSCRIPTION_REACTIVATED
  PLAN_LIMIT_WARNING
  CREDITS_LOW
  CREDITS_EXHAUSTED
  WORKFLOW_COMPLETED
  WORKFLOW_FAILED
  // Phase 29: previously-missing notification coverage found during the
  // repository audit — a scheduled run completing/failing and a payment
  // failure both had real handler code paths but no matching notification.
  WORKFLOW_RETRYING
  SCHEDULED_WORKFLOW_COMPLETED
  PAYMENT_FAILED
  APPROVAL_REQUIRED
  SECURITY_EVENT
}

/// Phase 29 Section 4: a lightweight, first-party product-event log — the
/// foundation every activation/retention/admin-intelligence metric this
/// phase adds is computed from. Deliberately NOT a general-purpose
/// analytics platform (no schema-per-event-type, no separate ingestion
/// service) — one flat table, one index per real query shape this phase
/// actually needs. `workspaceId`/`userId` are both nullable: some events
/// (`signup_started`) happen before either exists.
model ProductEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String?  @db.Uuid
  userId      String?  @db.Uuid
  eventName   String
  entityType  String?
  entityId    String?
  /// Structured event context. Never a raw AI prompt/completion, password,
  /// token, or API key — see phase28/29 security regression for a real,
  /// executed test proving this.
  properties  Json?
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, eventName, createdAt])
  @@index([eventName, createdAt])
  @@index([userId, createdAt])
  @@map("product_events")
}

/// Phase 29 Section 24: a lightweight, in-app customer feedback channel —
/// deliberately minimal (no attachments, no threading, no unnecessary
/// personal data beyond the authenticated actor already on the request).
model Feedback {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String         @db.Uuid
  userId      String         @db.Uuid
  type        FeedbackType
  message     String
  /// Free-form, server-populated context (current route, plan, browser) —
  /// never user-editable beyond `message`, never a credential/secret.
  context     Json?
  status      FeedbackStatus @default(OPEN)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([status, createdAt])
  @@index([type, createdAt])
  @@map("feedback")
}

enum FeedbackType {
  BUG
  IDEA
  QUESTION
  GENERAL
}

enum FeedbackStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

/// Phase 26 Section 8: observable, idempotent scheduler-job ledger. The
/// unique constraint on (jobKey, dedupeKey) is the actual concurrency
/// guarantee ("same billing period + same workspace = exactly one grant") —
/// mirrors WebhookEvent's proven pattern from Phase 25, not a new idea.
model ScheduledJobRun {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobKey      String
  dedupeKey   String
  status      JobRunStatus
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  error       String?
  createdAt   DateTime     @default(now())

  @@unique([jobKey, dedupeKey])
  @@index([jobKey, status])
  @@map("scheduled_job_runs")
}

enum JobRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

/// Phase 27 Section 4: a general-purpose, lease-based production job queue —
/// distinct from Phase 26's ScheduledJobRun (which is a narrow, single-purpose
/// idempotency ledger for the credit-grant job specifically). This model
/// supports arbitrary job types, claim/lease-based crash recovery (a worker
/// that dies mid-execution loses its lease and another worker reclaims the
/// job once `leaseExpiresAt` passes), and retry-with-backoff terminating in
/// a dead-letter FAILED state after `maxAttempts` is exhausted.
model Job {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobKey         String
  dedupeKey      String
  payload        Json?
  status         JobStatus @default(PENDING)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  leaseOwner     String?
  leaseExpiresAt DateTime?
  nextRunAt      DateTime  @default(now())
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?

  // Idempotent enqueue: at most one Job per (jobKey, dedupeKey), enforced by
  // a real Postgres unique constraint — not an app-level check-then-insert.
  @@unique([jobKey, dedupeKey])
  @@index([jobKey, status, nextRunAt])
  @@map("jobs")
}

enum JobStatus {
  PENDING
  CLAIMED
  RUNNING
  RETRY_WAIT
  SUCCEEDED
  FAILED
  /// Phase 29 Section 9: an admin-cancelled dead-letter job — distinct from
  /// FAILED (which means "exhausted its real retry attempts") so
  /// reliability metrics never conflate "the system gave up" with "an
  /// operator decided this one should never run."
  CANCELLED
}

/**
 * Phase 31: a real recurring backup schedule, deliberately a small,
 * dedicated model rather than reusing ScheduledWorkflow — a database
 * backup is not a workflow (no WorkflowDefinition, no workspace scoping,
 * no business input payload). Mirrors ScheduledWorkflow's already-certified
 * duplicate-prevention pattern exactly: `nextRunAt` is claimed via an
 * optimistic-concurrency CAS (see backup-scheduler.service.ts), with the
 * enqueued Job's real unique (jobKey, dedupeKey) constraint as a second,
 * independent layer of protection.
 */
model BackupSchedule {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String    @unique
  intervalHours Int       @default(24)
  timeOfDay     String    @default("03:00") // "HH:mm"
  timezone      String    @default("UTC") // IANA name
  enabled       Boolean   @default(true)
  nextRunAt     DateTime
  lastRunAt     DateTime?
  lastRunStatus String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([enabled, nextRunAt])
  @@map("backup_schedules")
}

/**
 * Phase 31: real, persisted backup-run history and metadata — every real
 * backup attempt (scheduled or manually triggered) gets exactly one row,
 * whether it succeeds or fails, so observability (Track D) and retention
 * cleanup have real data to work from rather than inferring state from
 * on-disk files alone. `prunedAt` is set when retention cleanup deletes the
 * on-disk artifact but deliberately keeps this row — the historical record
 * (who ran, when, how big, how long) outlives the disk data it describes,
 * the same way a real backup-lifecycle catalog behaves.
 */
model BackupRun {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status       BackupStatus @default(RUNNING)
  triggerType  String // 'SCHEDULED' | 'MANUAL'
  jobId        String?      @db.Uuid
  filePath     String?
  tableCount   Int?
  rowCount     Int?
  sizeBytes    Int?
  checksum     String?
  errorMessage String?
  startedAt    DateTime     @default(now())
  completedAt  DateTime?
  durationMs   Int?
  prunedAt     DateTime?
  createdAt    DateTime     @default(now())

  // Phase 32 Track B: whether this artifact's table files are AES-256-GCM
  // ciphertext (BACKUP_ENCRYPTION_KEY was configured at backup time).
  encrypted Boolean @default(false)

  // Phase 32 Track A: real off-site upload state — distinct from local
  // on-disk success, since either can fail independently of the other.
  s3Uploaded    Boolean   @default(false)
  s3UploadedAt  DateTime?
  s3Bucket      String?
  s3UploadError String?

  // Phase 32 Track D: automated restore verification — a real restore into
  // an isolated schema run automatically after this backup, not merely a
  // one-off manual rehearsal.
  restoreVerifiedAt  DateTime?
  restoreVerifiedOk  Boolean?
  restoreDurationMs  Int?
  restoreVerifyError String?

  @@index([status, startedAt])
  @@map("backup_runs")
}

enum BackupStatus {
  RUNNING
  SUCCEEDED
  /// A real corruption/integrity-check failure discovered AFTER the dump
  /// completed (checksum mismatch on self-verification) — distinct from
  /// FAILED (an error during the dump itself), so observability can tell
  /// "we couldn't back up" from "we backed up but the artifact is bad."
  CORRUPT
  FAILED
}

/**
 * Phase 33 Track C: real, enforced data retention — a recurring purge job,
 * mirroring BackupSchedule's already-certified duplicate-prevention and
 * missed-run-coalescing pattern exactly (same CAS-on-nextRunAt guarantee,
 * same Job-unique-constraint belt-and-suspenders). Deliberately weekly by
 * default (`intervalHours: 168`) — purging is a low-urgency, high-caution
 * operation, not a daily one.
 */
model DataRetentionSchedule {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String    @unique
  intervalHours Int       @default(168)
  timeOfDay     String    @default("04:00") // "HH:mm"
  timezone      String    @default("UTC")
  enabled       Boolean   @default(true)
  nextRunAt     DateTime
  lastRunAt     DateTime?
  lastRunStatus String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([enabled, nextRunAt])
  @@map("data_retention_schedules")
}

/**
 * Phase 33 Track C: real, persisted purge-run history — every real purge
 * attempt gets exactly one row, whether it succeeds or fails, mirroring
 * BackupRun's own audit-trail-outlives-the-action design. `purgedCounts` is
 * a real per-model breakdown (e.g. `{"lead": 12, "contact": 3, "workspaceMember": 1}`),
 * never a single opaque total — a real operator investigating "what did
 * this purge actually delete" must be able to answer that from this row
 * alone, not from application logs that may have rotated away.
 */
model DataRetentionPurgeRun {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status       PurgeStatus @default(RUNNING)
  triggerType  String // 'SCHEDULED' | 'MANUAL'
  jobId        String?     @db.Uuid
  purgedCounts Json?
  totalPurged  Int?
  errorMessage String?
  startedAt    DateTime    @default(now())
  completedAt  DateTime?
  durationMs   Int?
  createdAt    DateTime    @default(now())

  @@index([status, startedAt])
  @@map("data_retention_purge_runs")
}

enum PurgeStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

/**
 * Phase 33 Track L: a real, persisted background data-export run — the
 * export itself runs as a real job-queue job (never synchronously inside
 * an HTTP request, which would time out for a large workspace), so a
 * requester polls this row for real status rather than blocking on the
 * connection. `workspaceId` is the real, structural tenant-isolation
 * boundary — every list/download endpoint scopes strictly by it.
 */
model DataExportRun {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String    @db.Uuid
  requestedByUserId String?   @db.Uuid
  status            String    @default("RUNNING") // 'RUNNING' | 'SUCCEEDED' | 'FAILED'
  filePath          String?
  sizeBytes         Int?
  errorMessage      String?
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  durationMs        Int?
  createdAt         DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, startedAt])
  @@map("data_export_runs")
}

enum NotificationCategory {
  AI
  SALES
  SUPPORT
  MARKETING
  TEAM
  BILLING
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

/// Immutable compliance record. Deliberately has no `updatedAt` — rows are
/// never mutated after insert, only appended.
model AuditLog {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String         @db.Uuid
  actorUserId   String?        @db.Uuid // null = system-initiated
  action        AuditLogAction
  entityType    String
  entityId      String
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_logs")
}

enum AuditLogAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  PERMISSION_CHANGE
  LOGIN
  LOGOUT
  BILLING_CHANGE
  SETTINGS_CHANGE
  /// Phase 32 Track O: a real, full workspace data export was performed — sensitive enough to warrant its own real audit trail entry.
  DATA_EXPORT
}

/// Lightweight, human-facing feed — NOT the compliance record (see AuditLog).
/// Immutable, no `updatedAt`. `summary` is pre-rendered/denormalized for fast
/// feed rendering without joining across every possible entity type.
model Activity {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String       @db.Uuid
  actorUserId       String?      @db.Uuid
  type              ActivityType
  summary           String
  relatedEntityType String?
  relatedEntityId   String?
  createdAt         DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@map("activities")
}

enum ActivityType {
  CONTENT_PUBLISHED
  DEAL_MOVED
  TICKET_RESOLVED
  MEMBER_JOINED
  PROJECT_CREATED
  AI_GENERATION
  COMMENT_ADDED
}

