NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bizpilot_ai_dev?schema=public

JWT_SECRET=dev-only-secret-do-not-use-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-only-refresh-secret-do-not-use-in-production
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
