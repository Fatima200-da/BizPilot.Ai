# =============================================================================
# BizPilot.Ai backend environment configuration.
# Phase 20 Section 22: every variable below documents its purpose,
# required/optional status, a safe example value, and its production
# requirement. config/env.ts is the ONLY file allowed to read process.env
# directly — its Zod schema fails fast (throws at startup) if a required
# variable is missing or malformed, so production can never silently boot
# with an invalid/missing configuration.
# =============================================================================

# --- Server -------------------------------------------------------------
# NODE_ENV: required in spirit (has a safe default of "development", but
# production deployments MUST explicitly set "production" — several
# behaviors, e.g. Prisma client logging verbosity, key off this).
NODE_ENV=development
# PORT: optional (default 4000). The port the HTTP server listens on.
PORT=4000
# API_PREFIX: optional (default /api/v1). Mount path for all API routes.
API_PREFIX=/api/v1
# CORS_ORIGIN: optional (default localhost:5173) but MUST be set to the
# real frontend origin in staging/production — never "*", never multiple
# origins. A wrong value here either breaks the frontend or, worse, allows
# an unintended origin's credentialed requests.
CORS_ORIGIN=http://localhost:5173

# Number of reverse-proxy hops to trust for X-Forwarded-* headers (Express's
# `trust proxy`). Default `1` matches the documented production topology
# (nginx directly in front of the backend — docker-compose.prod.yml). Set to
# `0` when the backend is exposed directly with no proxy in front of it.
# Raise it if you add another proxy/load balancer in front of nginx. Never
# set to a value that trusts a hop you don't control — it lets a client
# forge its own IP via X-Forwarded-For, defeating IP-keyed rate limiting.
TRUST_PROXY=1

# --- Database -------------------------------------------------------------
# DATABASE_URL: REQUIRED, no default — the app refuses to start without it.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
# Production: point at a dedicated, least-privilege application role (see
# docs/PRODUCTION_ENVIRONMENT.md) — never the postgres superuser.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bizpilot_ai?schema=public
# USE_PGLITE_ADAPTER: optional (default false). Dev/CI-only fallback that
# swaps the real @prisma/adapter-pg driver for a hand-written in-process
# PGlite adapter (see infrastructure/database/pglite-adapter.ts) — used
# throughout Phases 16-20 because no networked PostgreSQL was reachable in
# this environment. MUST be false (or unset) in staging/production: PGlite
# is in-memory and loses all data on every restart.
USE_PGLITE_ADAPTER=false

# --- Auth -------------------------------------------------------------
# JWT_SECRET / JWT_REFRESH_SECRET: REQUIRED, minimum 16 characters, no
# default. Production: generate a unique, random, high-entropy secret per
# environment (e.g. `openssl rand -base64 48`) — never reuse the dev
# placeholder below, never commit the real value, never share the same
# secret between staging and production.
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-strong-random-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
# BCRYPT_SALT_ROUNDS: optional (default 10). Higher = slower hashing = more
# resistant to brute force but more CPU per login/register. 12 is a
# reasonable production value (re-verified as the perf-smoke.ts baseline's
# dominant cost for register — see PHASE_18/19 performance sections).
BCRYPT_SALT_ROUNDS=12

# --- Rate limiting & cost guardrails -------------------------------------
# RATE_LIMIT_WINDOW_MS / RATE_LIMIT_MAX_REQUESTS: optional (defaults shown).
# General per-identity (or per-IP if unauthenticated) request cap.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# REQUEST_TIMEOUT_MS: optional (default 30000). Hard ceiling on how long
# any single request may run before the server responds 503 rather than
# holding the connection open indefinitely (Phase 19 Section 11).
REQUEST_TIMEOUT_MS=30000
# WORKFLOW_RATE_LIMIT_WINDOW_MS / WORKFLOW_RATE_LIMIT_MAX_EXECUTIONS:
# optional (defaults shown). Cost guardrail distinct from the general rate
# limit above — caps how many workflow (AI-cost-incurring) runs one
# workspace may start per window, independent of its AI-credit balance
# (Phase 19 Section 19/20). Production: review against real usage before
# raising past the default.
WORKFLOW_RATE_LIMIT_WINDOW_MS=3600000
WORKFLOW_RATE_LIMIT_MAX_EXECUTIONS=20

# --- File uploads -------------------------------------------------------
# UPLOAD_MAX_FILE_SIZE_MB / UPLOAD_DIR: optional (defaults shown). Used by
# the Business Analyzer's CSV upload (multer.memoryStorage() — files are
# held as in-memory buffers, never written to UPLOAD_DIR as of this phase;
# UPLOAD_DIR is reserved for a future on-disk storage path).
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

# --- Automated backups (Phase 31) ---------------------------------------
# BACKUP_DIR: local disk path for daily database backup artifacts. Local
# disk by design this phase — no real off-host/cloud storage credential is
# configured; a real production deployment must additionally sync this
# directory off-host (S3, GCS, etc.) before it satisfies genuine disaster
# recovery. BACKUP_RETENTION_DAYS/BACKUP_MIN_RETAINED govern real on-disk
# cleanup (the floor always keeps the N most recent successful backups
# regardless of age). BACKUP_SCHEDULE_TIME is "HH:mm" UTC.
# BACKUP_STALE_RUNNING_MINUTES bounds how long a backup may appear RUNNING
# before a new attempt treats it as an abandoned/crashed run.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_MIN_RETAINED=3
BACKUP_SCHEDULE_TIME=03:00
BACKUP_STALE_RUNNING_MINUTES=120

# --- Off-site S3-compatible backup storage (Phase 32) -------------------
# All optional — backups remain local-disk-only if unset. Once ANY is set,
# S3_BUCKET/S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY are all required together
# (validated at startup). Works against real AWS S3, Cloudflare R2,
# Backblaze B2, DigitalOcean Spaces, MinIO, or any other S3-compatible
# endpoint via S3_ENDPOINT (leave unset for real AWS S3). Most non-AWS
# S3-compatible providers need S3_FORCE_PATH_STYLE=true.
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# --- Backup encryption at rest (Phase 32) --------------------------------
# BACKUP_ENCRYPTION_KEY: optional, but strongly recommended in production.
# A base64-encoded 32-byte AES-256 key. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Unset means backups remain unencrypted (matching Phase 31's default).
# BACKUP_ENCRYPTION_KEY=

# --- Enforced data retention (Phase 33) ----------------------------------
# DATA_RETENTION_DAYS: how long a soft-deleted row (Lead/Contact/
# WorkspaceMember) must remain recoverable before the weekly purge job may
# permanently delete it. DATA_RETENTION_SCHEDULE_TIME is "HH:mm" UTC.
DATA_RETENTION_DAYS=90
DATA_RETENTION_SCHEDULE_TIME=04:00

# --- AI provider -------------------------------------------------------
# AI_PROVIDER: optional (default "mock"). "mock" runs the product with zero
# paid-API dependency (MockProviderAdapter — deterministic fixture output,
# not a real LLM). Set to "openai" ONLY once a real budget/key decision has
# been made — every phase through 20 has run exclusively on "mock"; the
# "openai" path has never been exercised against a real API key.
AI_PROVIDER=mock
# OPENAI_API_KEY: required ONLY if AI_PROVIDER=openai (OpenAIAdapter's
# constructor throws if AI_PROVIDER=openai and this is empty). NEVER commit
# a real key — not in source, not in this file, not in logs, not in
# documentation, not in test fixtures. No real key has ever been used in
# this repository's history.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# --- Payment provider (Phase 28) ----------------------------------------
# PAYMENT_PROVIDER: optional (default "mock"). "mock" runs the product with
# zero paid-provider dependency (MockBillingProvider — deterministic
# fixture behavior, not a real payment processor). Set to "stripe" ONLY
# once a real Stripe TEST MODE account/key decision has been made — the
# "stripe" path (StripeBillingProvider) has never been exercised against a
# real Stripe account in this repository's history; only its local,
# no-network signature-verification code path has real test coverage.
PAYMENT_PROVIDER=mock
# STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET: required ONLY if
# PAYMENT_PROVIDER=stripe (env.ts's startup validation fails fast
# otherwise). Use a TEST MODE key (sk_test_...) outside production; env.ts
# rejects a live key (sk_live_...) in any non-production NODE_ENV, and
# rejects a test key in NODE_ENV=production. NEVER commit a real key — not
# in source, not in this file, not in logs, not in documentation, not in
# test fixtures, not baked into a Docker image or the frontend bundle. No
# real key has ever been used in this repository's history.
STRIPE_SECRET_KEY=replace-with-your-stripe-test-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-your-stripe-test-webhook-secret
# STRIPE_PUBLISHABLE_KEY: optional, only needed once a frontend checkout UI
# exists (not built as of this phase — see certification doc's E2E
# section). Safe to expose client-side by Stripe's own design (a
# publishable key is not a secret), unlike the two keys above.
STRIPE_PUBLISHABLE_KEY=replace-with-your-stripe-publishable-key
